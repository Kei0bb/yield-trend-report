# ─────────────────────────────────────────────────────────────────
# Product configuration
#
# CP/FT/SLT share ONE product_id and the same CP-schema tables (SEMI_CP_*);
# they are distinguished only by the PROCESS column value (e.g. cFT1).
#
# Per product (key = internal nickname; never shown in the UI):
#   display_name : product name (shown as secondary text next to product_id)
#                  products sharing a display_name are merged into one series
#   product_id   : DB PRODUCT_ID (the primary key selected/shown in the UI).
#                  A single value; '%' enables an Oracle LIKE wildcard.
#   bin_group    : bin_mappings/<bin_group>.csv (without extension)
#   bin_groups   : optional per-process overrides, e.g. {ft: main_ft}
#   processes    : logical process (cp / ft / slt) -> list of DB PROCESS values.
#                  ALWAYS write a list, even for one value: ft: [cFT1]
#
# How processes drives the Dashboard
# ----------------------------------
#   The list values are the actual strings in the DB PROCESS column; the query
#   filters on them (merged = PROCESS IN (...), sub = PROCESS = <value>).
#   The major-process name shown is the logical key in upper case (cp -> "CP").
#
#     cp: [CP1, CP2]   →   CP   (major, merged: PROCESS IN ('CP1','CP2'))
#                            └ CP1   (sub: PROCESS = 'CP1')
#                            └ CP2   (sub: PROCESS = 'CP2')
#
#   2+ values  → major (merged) row + one sub row per value
#   1 value    → major row only (a lone sub would duplicate it)
#   key omitted→ single row matching PROCESS = '<CP|FT|SLT>'
# ─────────────────────────────────────────────────────────────────
products:
  Product-A:
    display_name: Product-A
    product_id: P12345-A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  # Revision sharing the same display_name → merged with Product-A
  Product-A-rev2:
    display_name: Product-A
    product_id: P12346-A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  Product-B:
    display_name: Product-B
    product_id: P12345-B
    bin_group: main_b
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  SCT101:
    display_name: SCT101
    product_id: SCT101A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  # LIKE wildcard example: matches SC0G29AP3-ES, -ES-9Q1, ... in one query.
  Phoenix:
    display_name: Phoenix
    product_id: SC0G29AP3%
    bin_group: Phoenix
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  # Multi sub-process example: CP and FT each have several DB PROCESS values.
  # Dashboard renders, per logical process, a merged "major" row plus one
  # indented sub-process row per value:
  #   CP (merged: CP1+CP2)        FT (merged: cFT1+cFT2)
  #     └ CP1                       └ cFT1
  #     └ CP2                       └ cFT2
  Orion:
    display_name: Orion
    product_id: ORN-100
    bin_group: main
    processes:
      cp: [CP1, CP2]
      ft: [cFT1, cFT2]
      slt: [cSLT1]
