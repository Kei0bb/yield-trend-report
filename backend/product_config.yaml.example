# ─────────────────────────────────────────────────────────────────
# Product configuration
#
# CP/FT/SLT share ONE product_id and the same CP-schema tables (SEMI_CP_*);
# they are distinguished only by the PROCESS column value (e.g. cFT1).
#
# Per product (key = internal nickname; never shown in the UI):
#   display_name : product name (shown as secondary text next to product_id)
#                  products sharing a display_name are merged into one series
#   product_id   : DB PRODUCT_ID (the primary key selected/shown in the UI).
#                  A single value; '%' enables an Oracle LIKE wildcard.
#   bin_group    : bin_mappings/<bin_group>.csv (without extension)
#   bin_groups   : optional per-process overrides, e.g. {ft: main_ft}
#   processes    : logical process (cp / ft / slt) → DB PROCESS value(s).
#
# processes entry forms
# ─────────────────────
#   scalar  ft: cFT1
#               → major row queries PROCESS = 'cFT1'; no sub rows
#
#   list    cp: [CP, CP1, CP2]
#               → first element is the major row (PROCESS = 'CP', clean roll-up)
#                 remaining elements are sub rows (each PROCESS = 'CP1' etc.)
#                 NOT stacked — the major row does NOT include CP1/CP2 data
#             cp: [cFT1]
#               → single-element list treated as scalar (major only, no subs)
#
#   dict    cp: {major: CP, subs: [CP1, CP2]}
#               → explicit form; same semantics as the list above
#           cp: {major: CP}
#               → major row only, no sub rows
#           cp: {subs: [CP1, CP2]}
#               → NO major row; only CP1 and CP2 sub rows
#                 (useful when DB has no clean roll-up PROCESS value)
#
#   key absent (omitted entirely)
#               → single row querying PROCESS = '<CP|FT|SLT>' literally
#                 (backward-compatible default)
#
# report (REQUIRED for a product to appear on the Report page)
# ───────────────────────────────────────────────────────────────
#   Defines the Report page / PDF output units for a product: one chart on
#   screen and one page in the PDF per unit, in the listed order.
#
#   IMPORTANT: once product_config.yaml exists, a product is selectable on
#   the Report page ONLY if it has a non-empty, valid `report:` list. There
#   is NO implicit CP/FT/SLT fallback per-product anymore — a configured
#   product with no `report:` (or an empty/malformed one) simply does not
#   appear on the Report page (GET /api/report-products excludes it), even
#   though it can still appear on the Dashboard/Explore via `processes:`.
#   The CP/FT/SLT fallback only kicks in when product_config.yaml itself is
#   absent (mock/legacy mode) or the nickname is completely unconfigured.
#
#     report:
#       - {family: cp, label: "CP",   values: [CP]}     # major CP
#       - {family: cp, label: "CP1",  values: [CP1]}     # subs CP1
#       - {family: cp, label: "CP2",  values: [CP2]}     # subs CP2
#       - {family: ft, label: "cFT1", values: [cFT1]}    # subs-only FT
#
#   family : cp / ft / slt (case-insensitive) — used for bin_group resolution
#   label  : display string AND the data-dict key (chart/page title); must be
#            unique within the product
#   values : non-empty list of DB PROCESS values to query; >1 entries are
#            merged into one series (no implicit "stacking" otherwise)
#
# target (optional)
# ──────────────────
#   Per-process numeric yield targets (%), drawn as a faint dashed reference
#   line on the Dashboard sparkline/Latest-yield cell AND on the Explore trend
#   chart. NOT shown on the Report page or in the PDF export (those stay
#   visually frozen).
#
#   MUST be a mapping {label: value} — there is no scalar form and no
#   `default` key. A scalar `target: 90` is ignored (logged warning).
#
#   The lookup label depends on row level:
#     - Dashboard major row / Explore (no sub selected): the major process
#       name "CP" / "FT" / "SLT"
#     - Dashboard sub row / Explore (sub selected): the sub-process's DB
#       PROCESS value, e.g. "cFT1"
#   A label with no entry in the mapping draws no reference line.
#
#     target:
#       CP: 90        # major CP row
#       FT: 85        # major FT row
#       SLT: 80       # major SLT row
#       cFT1: 84      # FT's sub-process row (PROCESS='cFT1')
#
# Dashboard layout example for Orion:
#   CP (major: PROCESS='CP')        FT (major: PROCESS='cFT1')
#     └ CP1  (PROCESS='CP1')          └ cFT2  (PROCESS='cFT2')
#     └ CP2  (PROCESS='CP2')
# ─────────────────────────────────────────────────────────────────
products:
  Product-A:
    display_name: Product-A
    product_id: P12345-A
    bin_group: main
    target:
      CP: 90
      FT: 85
      SLT: 80
      cFT1: 84
    processes:
      ft: [cFT1]
      slt: [cSLT1]
    report:
      - {family: cp, label: "CP", values: [CP]}
      - {family: ft, label: "FT", values: [cFT1]}
      - {family: slt, label: "SLT", values: [cSLT1]}
    wat:
      pairs:
        - label: Core RVT
          vth:   {n: VTHN_RVT,   p: VTHP_RVT}
          idsat: {n: IDSATN_RVT, p: IDSATP_RVT}
        - label: Core LVT
          vth:   {n: VTHN_LVT,   p: VTHP_LVT}
          idsat: {n: IDSATN_LVT, p: IDSATP_LVT}
        - label: Core HVT
          vth:   {n: VTHN_HVT,   p: VTHP_HVT}
          idsat: {n: IDSATN_HVT, p: IDSATP_HVT}
        - label: Core ULVT
          vth:   {n: VTHN_ULVT,   p: VTHP_ULVT}
          idsat: {n: IDSATN_ULVT, p: IDSATP_ULVT}
        - label: IO 2.5V
          vth:   {n: VTHN_IO25,   p: VTHP_IO25}
          idsat: {n: IDSATN_IO25, p: IDSATP_IO25}
        - label: IO 1.8V
          vth:   {n: VTHN_IO18,   p: VTHP_IO18}
          idsat: {n: IDSATN_IO18, p: IDSATP_IO18}

  # Revision sharing the same display_name → merged with Product-A
  Product-A-rev2:
    display_name: Product-A
    product_id: P12346-A
    bin_group: main
    target:
      CP: 90
      FT: 85
      SLT: 80
      cFT1: 84
    processes:
      ft: [cFT1]
      slt: [cSLT1]
    report:
      - {family: cp, label: "CP", values: [CP]}
      - {family: ft, label: "FT", values: [cFT1]}
      - {family: slt, label: "SLT", values: [cSLT1]}

  Product-B:
    display_name: Product-B
    product_id: P12345-B
    bin_group: main_b
    target:
      CP: 92
      FT: 87
      SLT: 82
      cFT1: 86
    processes:
      ft: [cFT1]
      slt: [cSLT1]
    report:
      - {family: cp, label: "CP", values: [CP]}
      - {family: ft, label: "FT", values: [cFT1]}
      - {family: slt, label: "SLT", values: [cSLT1]}

  SCT101:
    display_name: SCT101
    product_id: SCT101A
    bin_group: main
    target:
      CP: 88
      FT: 83
      SLT: 78
      cFT1: 82
    processes:
      ft: [cFT1]
      slt: [cSLT1]
    report:
      - {family: cp, label: "CP", values: [CP]}
      - {family: ft, label: "FT", values: [cFT1]}
      - {family: slt, label: "SLT", values: [cSLT1]}

  # LIKE wildcard example: matches SC0G29AP3-ES, -ES-9Q1, ... in one query.
  # Also demonstrates the required `report:` key: explicit Report/PDF units
  # (one chart on screen + one PDF page per unit, in this order).
  # target keys here use the sub-process DB PROCESS values (CP1/CP2/cFT1)
  # since CP/FT have no clean major roll-up in this product.
  Phoenix:
    display_name: Phoenix
    product_id: SC0G29AP3%
    bin_group: Phoenix
    target:
      CP1: 91
      CP2: 89
      cFT1: 86
    processes:
      cp: [CP, CP1, CP2]
      ft: {subs: [cFT1]}
    report:
      - {family: cp, label: "CP",   values: [CP]}
      - {family: cp, label: "CP1",  values: [CP1]}
      - {family: ft, label: "cFT1", values: [cFT1]}

  # Multi sub-process example: CP has a clean roll-up in the DB, plus two
  # sub-process PROCESS values; FT also has a major + one sub.
  # The major row queries ONLY its own value — no stacking/double-counting.
  # NOTE: this product has no `report:` block, so it appears on the
  # Dashboard/Explore (via `processes:`) but is EXCLUDED from the Report page
  # (GET /api/report-products) — demonstrates the new explicit-report rule.
  #
  #   Dashboard layout:
  #     CP  (major: PROCESS='CP')       FT  (major: PROCESS='cFT1')
  #       └ CP1  (PROCESS='CP1')          └ cFT2  (PROCESS='cFT2')
  #       └ CP2  (PROCESS='CP2')
  Orion:
    display_name: Orion
    product_id: ORN-100
    bin_group: main
    processes:
      cp: [CP, CP1, CP2]      # major row 'CP' (clean) + sub rows CP1, CP2 (NOT stacked)
      ft: [cFT1, cFT2]        # major 'cFT1' + sub cFT2
      slt: [cSLT1]

  # Subs-only example: DB has no clean roll-up for CP; show only individual steps.
  # cp: {subs: [CP1, CP2]}   # no major row, only CP1/CP2 sub rows

#
# wat (optional — PCM/WAT tab の散布図に必要)
# ─────────────────────────────────────────────────────────────────
#   WAT_MEASURE_DETAIL.ITEM_NAME の命名は製品ごとに違うため、散布図で
#   使う Vth / Idsat の N・P 項目名をここで対応付ける。
#   pairs は宣言順に表示され、1 組につき 4 図（Vth n/p, Idsat n/p,
#   Ion-Vt N, Ion-Vt P）を描く。
#   このブロックを省くと散布図セクションごと非表示になる
#   （サマリーテーブルは通常どおり表示される）。
#
#   wat:
#     pairs:
#       - label: Core RVT
#         vth:   {n: VTHN_RVT,   p: VTHP_RVT}
#         idsat: {n: IDSATN_RVT, p: IDSATP_RVT}
#       - label: Core LVT
#         vth:   {n: VTHN_LVT,   p: VTHP_LVT}
#         idsat: {n: IDSATN_LVT, p: IDSATP_LVT}
