# ─────────────────────────────────────────────────────────────────
# Product configuration
#
# CP/FT/SLT share ONE product_id and the same CP-schema tables (SEMI_CP_*);
# they are distinguished only by the PROCESS column value (e.g. cFT1).
#
# Per product (key = internal nickname; never shown in the UI):
#   display_name : product name (shown as secondary text next to product_id)
#                  products sharing a display_name are merged into one series
#   product_id   : DB PRODUCT_ID (the primary key selected/shown in the UI).
#                  A single value; '%' enables an Oracle LIKE wildcard.
#   bin_group    : bin_mappings/<bin_group>.csv (without extension)
#   bin_groups   : optional per-process overrides, e.g. {ft: main_ft}
#   processes    : logical process (cp / ft / slt) → DB PROCESS value(s).
#
# processes entry forms
# ─────────────────────
#   scalar  ft: cFT1
#               → major row queries PROCESS = 'cFT1'; no sub rows
#
#   list    cp: [CP, CP1, CP2]
#               → first element is the major row (PROCESS = 'CP', clean roll-up)
#                 remaining elements are sub rows (each PROCESS = 'CP1' etc.)
#                 NOT stacked — the major row does NOT include CP1/CP2 data
#             cp: [cFT1]
#               → single-element list treated as scalar (major only, no subs)
#
#   dict    cp: {major: CP, subs: [CP1, CP2]}
#               → explicit form; same semantics as the list above
#           cp: {major: CP}
#               → major row only, no sub rows
#           cp: {subs: [CP1, CP2]}
#               → NO major row; only CP1 and CP2 sub rows
#                 (useful when DB has no clean roll-up PROCESS value)
#
#   key absent (omitted entirely)
#               → single row querying PROCESS = '<CP|FT|SLT>' literally
#                 (backward-compatible default)
#
# report (optional, EXPLICIT form only)
# ───────────────────────────────────────
#   Defines the Report page / PDF output units for a product: one chart on
#   screen and one page in the PDF per unit, in the listed order. When absent
#   the Report falls back to the current CP/FT/SLT behavior (via processes:).
#
#     report:
#       - {family: cp, label: "CP",   values: [CP]}     # major CP
#       - {family: cp, label: "CP1",  values: [CP1]}     # subs CP1
#       - {family: cp, label: "CP2",  values: [CP2]}     # subs CP2
#       - {family: ft, label: "cFT1", values: [cFT1]}    # subs-only FT
#
#   family : cp / ft / slt (case-insensitive) — used for bin_group resolution
#   label  : display string AND the data-dict key (chart/page title); must be
#            unique within the product
#   values : non-empty list of DB PROCESS values to query; >1 entries are
#            merged into one series (no implicit "stacking" otherwise)
#
# Dashboard layout example for Orion:
#   CP (major: PROCESS='CP')        FT (major: PROCESS='cFT1')
#     └ CP1  (PROCESS='CP1')          └ cFT2  (PROCESS='cFT2')
#     └ CP2  (PROCESS='CP2')
# ─────────────────────────────────────────────────────────────────
products:
  Product-A:
    display_name: Product-A
    product_id: P12345-A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  # Revision sharing the same display_name → merged with Product-A
  Product-A-rev2:
    display_name: Product-A
    product_id: P12346-A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  Product-B:
    display_name: Product-B
    product_id: P12345-B
    bin_group: main_b
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  SCT101:
    display_name: SCT101
    product_id: SCT101A
    bin_group: main
    processes:
      ft: [cFT1]
      slt: [cSLT1]

  # LIKE wildcard example: matches SC0G29AP3-ES, -ES-9Q1, ... in one query.
  # Also demonstrates the optional `report:` key: explicit Report/PDF units
  # (one chart on screen + one PDF page per unit, in this order) instead of
  # the default CP/FT/SLT chips.
  Phoenix:
    display_name: Phoenix
    product_id: SC0G29AP3%
    bin_group: Phoenix
    processes:
      cp: [CP, CP1, CP2]
      ft: {subs: [cFT1]}
    report:
      - {family: cp, label: "CP",   values: [CP]}
      - {family: cp, label: "CP1",  values: [CP1]}
      - {family: ft, label: "cFT1", values: [cFT1]}

  # Multi sub-process example: CP has a clean roll-up in the DB, plus two
  # sub-process PROCESS values; FT also has a major + one sub.
  # The major row queries ONLY its own value — no stacking/double-counting.
  #
  #   Dashboard layout:
  #     CP  (major: PROCESS='CP')       FT  (major: PROCESS='cFT1')
  #       └ CP1  (PROCESS='CP1')          └ cFT2  (PROCESS='cFT2')
  #       └ CP2  (PROCESS='CP2')
  Orion:
    display_name: Orion
    product_id: ORN-100
    bin_group: main
    processes:
      cp: [CP, CP1, CP2]      # major row 'CP' (clean) + sub rows CP1, CP2 (NOT stacked)
      ft: [cFT1, cFT2]        # major 'cFT1' + sub cFT2
      slt: [cSLT1]

  # Subs-only example: DB has no clean roll-up for CP; show only individual steps.
  # cp: {subs: [CP1, CP2]}   # no major row, only CP1/CP2 sub rows
