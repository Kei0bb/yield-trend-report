# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/

# uv — lock file はコミットする、キャッシュは除外
.uv-cache/
.env
.env.*
!.env.example

# Node / Frontend
node_modules/
dist/
.cache/
*.local

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
.coverage
htmlcov/
.pytest_cache/

# Kaleido / Plotly cache
.plotly/

# PDF output (generated at runtime)
*.pdf

# 製品設定
!backend/product_config.csv.example

# bin マッピングは bin_mappings/ 配下に品種別 CSV を配置
# 本体 *.csv は環境別管理（gitignore）、サンプル *.csv.example と README はコミット
backend/bin_mappings/*.csv
!backend/bin_mappings/*.csv.example

# Verification screenshots / debug images (generated locally)
/*.png
/*.jpg
/*.jpeg
